@model IEnumerable<BTTHLTW_Webbanhang.Models.Product>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}
<h2>Danh sách sản phẩm</h2>
<table class="table">
    <div class="mb-3 text-end">
        @* <a asp-action="Add" class="btn btn-primary">Tạo mới</a> *@
    </div>
    <thead>
        <tr>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Hình ảnh</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
        
            <tr>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td><img src="@product.ImageUrl" alt="@product.Name" width="100" /></td>
                <td>
                    @* <a asp-action="Update" class="btn btn-success" asp-route-id="@product.Id">Sửa</a>
                    <a asp-action="Delete" class="btn btn-success" asp-route-id="@product.Id">Xoá</a> *@
                    <a asp-action="Display" class="btn btn-success" asp-route-id="@product.Id">Chi Tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>