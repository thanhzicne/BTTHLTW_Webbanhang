@model BTTHLTW_Webbanhang.Models.Order

@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">Thông tin thanh toán</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Checkout" method="post">
                        <div class="mb-3">
                            <label asp-for="ShippingAddress" class="form-label fw-semibold">Địa chỉ giao hàng</label>
                            <input asp-for="ShippingAddress" class="form-control" placeholder="Nhập địa chỉ nhận hàng..." />
                            <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-semibold">Ghi chú</label>
                            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Ghi chú thêm (nếu có)..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-circle-fill me-1"></i> Đặt hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
